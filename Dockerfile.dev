FROM osrf/ros:humble-desktop

# Accept UID and GID as build arguments
ARG USER_UID=1000
ARG USER_GID=1000
ARG USERNAME=rosdev

# Create the user and group
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && apt-get update \
    && apt-get install -y sudo \
    && echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# Switch to the new non-root user
USER $USERNAME
ENV HOME=/home/$USERNAME

# Automatically source ROS Humble setup script
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc

# Force bash to save history in real-time
RUN echo "shopt -s histappend" >> ~/.bashrc \
    && echo "PROMPT_COMMAND='history -a; history -n'" >> ~/.bashrc
